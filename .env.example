# ─────────────────────────────────────────────
#  Sport Space Pro — required environment variables
#  Copy this file to .env.local and fill in the values.
#  Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email addresses used by API routes
# Must be a verified sender domain in Resend
CONTACT_EMAIL_FROM=Sport Space Pro <noreply@sportprospace.eu>
CONTACT_EMAIL_TO=hello@sportprospace.eu

# ─────────────────────────────────────────────
#  Firebase / Firestore — stores Commercial Score submissions
#
#  Optional. Without these the /commercial-score flow still works and
#  still emails the lead; only the stored record used for funnel
#  analysis and model recalibration is skipped.
#
#  Where to get them: Firebase Console → Project settings →
#  Service accounts → Generate new private key. The downloaded JSON
#  contains project_id, client_email and private_key.
#
#  FIREBASE_PRIVATE_KEY must keep its surrounding quotes and its
#  literal \n sequences — the app converts them to real newlines.
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
