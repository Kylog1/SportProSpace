# ─────────────────────────────────────────────
#  Sport Pro Space — required environment variables
#  Copy this file to .env.local and fill in the values.
#  Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email addresses used by API routes
# Must be a verified sender domain in Resend
CONTACT_EMAIL_FROM=Sport Pro Space <noreply@sportprospace.eu>
CONTACT_EMAIL_TO=hello@sportprospace.eu
